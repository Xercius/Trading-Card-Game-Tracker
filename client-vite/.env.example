# =============================================================================
# Trading Card Game Tracker - Client Environment Configuration
# =============================================================================
# Copy this file to .env.local. Configuration 1 is active by default;
# to use Configuration 2, comment out VITE_API_BASE above and uncomment
# the lines under Configuration 2.
# See README.md for detailed explanation of each configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# Configuration 1: Direct connection (Recommended)
# -----------------------------------------------------------------------------
# Use an absolute URL to connect directly to the API server.
# The Vite dev server proxy automatically disables itself.
#
# Use this for standard local development.
# -----------------------------------------------------------------------------
VITE_API_BASE=https://localhost:7226/api

# -----------------------------------------------------------------------------
# Configuration 2: Proxy-based connection
# -----------------------------------------------------------------------------
# Use a relative URL with the Vite dev server proxy.
# Uncomment the lines for your target protocol (HTTP or HTTPS) and comment out
# the absolute VITE_API_BASE above.
#
# Use this when you need to route through the Vite dev server or test proxy
# behavior. The proxy supports both HTTP and HTTPS target origins.
# Note: HTTPS targets require trusting self-signed certificates.
# -----------------------------------------------------------------------------
# HTTPS
# VITE_API_BASE=/api
# VITE_DEV_SERVER_PROXY_TARGET=https://localhost:7226

# HTTP
# VITE_API_BASE=/api
# VITE_DEV_SERVER_PROXY_TARGET=http://localhost:5229
