# Automatically detect text files and normalize line endings.
* text=auto

# Source code
*.cs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Configuration and data
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Scripts
*.sh text eol=lf

# Explicitly identify common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary

# Auto-generated & lockfiles (collapse in PR diffs & skip in automated code reviews)
api/Migrations/*.Designer.cs linguist-generated=true
api/Migrations/AppDbContextModelSnapshot.cs linguist-generated=true
**/package-lock.json linguist-generated=true
