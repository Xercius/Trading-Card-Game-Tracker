# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- IDE / tooling ----
.vs/
.vscode/
*.user

# ---- Environment variables ----
.env
.env.*
!.env.example
!.env.*.example

# ---- .NET build outputs ----
**/bin/
**/obj/
**/TestResults/
*.trx
*.coverage

# ---- Frontend: Vite (client-vite) ----
client-vite/node_modules/
client-vite/dist/
client-vite/storybook-static/
client-vite/coverage/
client-vite/.vite/
client-vite/.turbo/
client-vite/.eslintcache

# Also catch any nested node projects
**/node_modules/
**/dist/
**/.vite/
**/.vitest/
**/.vitest-cache/

# ---- SQLite database files ----
# Keep the main DB file ignored and include sidecars
api/app.db
api/app.db-shm
api/app.db-wal

# Conservative sidecar patterns in case names vary
*.db-shm
*.db-wal
*.db-journal

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Source data imports (not tracked) ----
Imports/

# ---- Static assets (local images, not source-controlled) ----
api/wwwroot/images/**/*
!api/wwwroot/images/**/
!api/wwwroot/images/tcg_tracker_logo.png
!api/wwwroot/images/games/**
!api/wwwroot/images/*/sets/**
!api/wwwroot/images/*/aspects/**
!api/wwwroot/images/*/arenas/**
!api/wwwroot/images/*/icons/**
!api/wwwroot/images/placeholders/**
!api/wwwroot/images/**/*.svg
!api/wwwroot/images/**/.gitkeep

client-vite/public/images/**/*
!client-vite/public/images/**/
!client-vite/public/images/tcg_tracker_logo.png
!client-vite/public/images/games/**
!client-vite/public/images/*/sets/**
!client-vite/public/images/*/aspects/**
!client-vite/public/images/*/arenas/**
!client-vite/public/images/*/icons/**
!client-vite/public/images/placeholders/**
!client-vite/public/images/**/*.svg
!client-vite/public/images/**/.gitkeep
